<resources>

    <style name="Theme.Ddys" parent="@style/Theme.Leanback">
        <item name="detailsDescriptionTitleStyle">@style/CustomLbDetailsDescriptionTitleStyle</item>
        <item name="playbackControlsButtonStyle">@style/TouchCompatiblePlaybackControlsButtonStyle</item>
    </style>

    <style name="CustomLbDetailsDescriptionTitleStyle" parent="Widget.Leanback.DetailsDescriptionTitleStyle">
        <item name="android:paddingTop">5dp</item>
    </style>

    <style name="TouchCompatiblePlaybackControlsButtonStyle" parent="Widget.Leanback.PlaybackControlsButtonStyle">
        <!-- Preserve D-pad focus while allowing the first touch to activate a control. -->
        <item name="android:focusableInTouchMode">false</item>
    </style>

</resources>
